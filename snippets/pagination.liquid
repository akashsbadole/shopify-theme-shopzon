{% comment %}
  Pagination Snippet
  Usage: {% render 'pagination', paginate: paginate %}
{% endcomment %}

{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t | default: 'Pagination' }}">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="pagination-item" aria-label="{{ 'general.pagination.previous' | t | default: 'Previous page' }}">
        <span class="material-symbols-outlined" aria-hidden="true" style="font-size:18px">chevron_left</span>
      </a>
    {%- else -%}
      <span class="pagination-item disabled" aria-disabled="true" aria-label="{{ 'general.pagination.previous' | t | default: 'Previous page' }}">
        <span class="material-symbols-outlined" aria-hidden="true" style="font-size:18px">chevron_left</span>
      </span>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a
          href="{{ part.url }}"
          class="pagination-item{% if part.title == paginate.current_page %} active{% endif %}"
          {% if part.title == paginate.current_page %}aria-current="page"{% endif %}
          aria-label="{{ 'general.pagination.page' | t: number: part.title | default: 'Page ' | append: part.title }}"
        >
          {{ part.title }}
        </a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="pagination-item active" aria-current="page" aria-label="{{ 'general.pagination.current_page' | t: number: part.title | default: 'Page ' | append: part.title }}">
          {{ part.title }}
        </span>
      {%- else -%}
        <span class="pagination-item" style="border:none;color:var(--color-text-secondary)" aria-hidden="true">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="pagination-item" aria-label="{{ 'general.pagination.next' | t | default: 'Next page' }}">
        <span class="material-symbols-outlined" aria-hidden="true" style="font-size:18px">chevron_right</span>
      </a>
    {%- else -%}
      <span class="pagination-item disabled" aria-disabled="true" aria-label="{{ 'general.pagination.next' | t | default: 'Next page' }}">
        <span class="material-symbols-outlined" aria-hidden="true" style="font-size:18px">chevron_right</span>
      </span>
    {%- endif -%}
  </nav>
{%- endif -%}
