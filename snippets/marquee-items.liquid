{% for block in section.blocks %}
  {% if block.type == 'item' %}
    <span class="marquee-item" {{ block.shopify_attributes }}>
      {% if block.settings.icon != blank %}
        <span class="material-symbols-outlined" style="font-size:16px">{{ block.settings.icon }}</span>
      {% endif %}
      {{ block.settings.text }}
    </span>
    <span class="marquee-item" style="opacity:0.3">✦</span>
  {% endif %}
{% endfor %}