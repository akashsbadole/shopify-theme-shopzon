<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Coming Soon</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
  {{ content_for_header }}
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', sans-serif;
      background: #131921;
      color: #fff;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .logo { font-size: 36px; font-weight: 800; margin-bottom: 40px; letter-spacing: -0.03em; }
    .logo span { color: #FF9900; }
    .container { max-width: 500px; width: 100%; text-align: center; }
    .badge { display: inline-block; background: #FF9900; color: #131921; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 12px; border-radius: 99px; margin-bottom: 24px; }
    h1 { font-size: clamp(28px, 6vw, 48px); font-weight: 800; line-height: 1.1; margin-bottom: 16px; }
    p { font-size: 16px; color: rgba(255,255,255,0.7); margin-bottom: 40px; line-height: 1.6; }
    .password-form { display: flex; flex-direction: column; gap: 12px; }
    .password-form input {
      padding: 12px 16px; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;
      background: rgba(255,255,255,0.08); color: #fff; font-size: 15px;
      font-family: 'Inter', sans-serif; outline: none;
    }
    .password-form input:focus { border-color: #FF9900; }
    .password-form input::placeholder { color: rgba(255,255,255,0.4); }
    .btn { padding: 12px; background: #FF9900; color: #131921; border: none; border-radius: 8px; font-size: 15px; font-weight: 700; cursor: pointer; font-family: 'Inter', sans-serif; }
    .btn:hover { background: #E47911; }
    .error { color: #ff6b6b; font-size: 13px; margin-top: -4px; }
    .divider { border: none; border-top: 1px solid rgba(255,255,255,0.1); margin: 32px 0; }
    .newsletter { }
    .newsletter h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
    .newsletter p { font-size: 13px; color: rgba(255,255,255,0.6); margin-bottom: 16px; }
    .newsletter-form { display: flex; gap: 8px; }
    .newsletter-form input { flex: 1; }
    .newsletter-form .btn { padding: 12px 20px; white-space: nowrap; }
    .social { display: flex; justify-content: center; gap: 16px; margin-top: 32px; }
    .social a { color: rgba(255,255,255,0.5); display: flex; align-items: center; transition: color 0.2s; }
    .social a:hover { color: #FF9900; }
    .social .material-symbols-outlined { font-size: 22px; }
    footer { margin-top: 48px; font-size: 12px; color: rgba(255,255,255,0.3); }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">{{ shop.name | split: ' ' | first }}<span>{{ shop.name | split: ' ' | last }}</span></div>
    <span class="badge">Coming Soon</span>
    <h1>We're getting ready for something great</h1>
    <p>Our store is under construction. Enter the password below to preview it, or subscribe to be the first to know when we launch.</p>

    {% form 'storefront_password' %}
      <div class="password-form">
        {% if form.errors %}
          <p class="error">{{ form.errors | default_errors }}</p>
        {% endif %}
        <input type="password" name="password" placeholder="Enter store password" required>
        <button type="submit" class="btn">Enter Store</button>
      </div>
    {% endform %}

    <hr class="divider">

    <div class="newsletter">
      <h3>Get notified at launch</h3>
      <p>Be the first to hear about exclusive deals and our official opening.</p>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter,launch">
        {% if form.posted_successfully? %}
          <p style="color:#67e8a9;font-size:14px">✓ You're on the list! We'll email you when we launch.</p>
        {% else %}
          <div class="newsletter-form">
            <input type="email" name="contact[email]" placeholder="your@email.com" required>
            <button type="submit" class="btn">Notify me</button>
          </div>
        {% endif %}
      {% endform %}
    </div>

    <div class="social">
      {% if settings.social_instagram != blank %}
        <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
          <span class="material-symbols-outlined">photo_camera</span>
        </a>
      {% endif %}
      {% if settings.social_facebook != blank %}
        <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
          <span class="material-symbols-outlined">public</span>
        </a>
      {% endif %}
      {% if settings.social_twitter != blank %}
        <a href="{{ settings.social_twitter }}" target="_blank" rel="noopener" aria-label="Twitter">
          <span class="material-symbols-outlined">alternate_email</span>
        </a>
      {% endif %}
    </div>

    <footer>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</footer>
  </div>
  {{ content_for_layout }}
</body>
</html>
