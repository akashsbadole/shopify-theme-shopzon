<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0">
  <meta name="theme-color" content="#232F3E">

  {%- if page_description -%}
    {%- assign meta_desc = page_description | escape -%}
    {%- if meta_desc.size > 160 -%}
      {%- assign meta_desc = meta_desc | truncate: 155 -%}{{ '...' -}}
    {%- endif -%}
    <meta name="description" content="{{ meta_desc }}">
  {%- elsif settings.seo_default_description -%}
    <meta name="description" content="{{ settings.seo_default_description | escape }}">
  {%- endif -%}

  {%- assign noindex_templates = 'cart,search,blog,account,login,register,reset_password,orders,order,addresses' | split: ',' -%}
  {%- assign is_noindex = false -%}
  {%- if noindex_templates contains template.name -%}
    {%- assign is_noindex = true -%}
  {%- elsif template.name == 'collection' and collection.handle != 'all' and settings.seo_noindex_collections -%}
    {%- assign is_noindex = true -%}
  {%- elsif template.name == 'search' and settings.seo_noindex_search -%}
    {%- assign is_noindex = true -%}
  {%- elsif template.name == 'blog' and settings.seo_noindex_blog -%}
    {%- assign is_noindex = true -%}
  {%- endif -%}

  {%- if is_noindex -%}
    <meta name="robots" content="noindex,{% if template.name == 'blog' %}follow{% else %}nofollow{% endif %}">
  {%- else -%}
    <meta name="robots" content="index, follow">
  {%- endif -%}

  {%- if settings.seo_google_verify -%}
    <meta name="google-site-verification" content="{{ settings.seo_google_verify }}">
  {%- endif -%}

  {%- if settings.seo_bing_verify -%}
    <meta name="msvalidate.01" content="{{ settings.seo_bing_verify }}">
  {%- endif -%}

  {%- if settings.seo_keywords and template.name == 'product' -%}
    <meta name="keywords" content="{{ settings.seo_keywords }}">
  {%- endif -%}

  <title>
    {% if seo_title %}{{ seo_title | escape }}
    {% elsif template.name == 'product' and product %}
      {{ product.title | escape }} | {{ shop.name }} | Free Shipping
    {% elsif template.name == 'collection' and collection %}
      {{ collection.title | escape }} - Buy Online at {{ shop.name }}
    {% elsif template.name == 'blog' and blog %}
      {{ blog.title | escape }} - {{ shop.name }} Blog
    {% elsif template.name == 'article' and article %}
      {{ article.title | escape }} | {{ shop.name }}
    {% else %}
      {{ page_title | escape }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    {% endif %}
  </title>

  <link rel="canonical" href="{{ canonical_url }}">
  {%- for locale in localization.available -%}
  <link rel="alternate" hreflang="{{ locale.iso_code }}" href="{{ request.origin }}{{ request.path }}?locale_id={{ locale.id }}">
  {%- endfor -%}
  <link rel="alternate" hreflang="x-default" href="{{ request.origin }}{{ request.path }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <link rel="dns-prefetch" href="https://www.google.com">
   <link rel="dns-prefetch" href="https://www.googletagmanager.com">

   {%- if settings.custom_code_head != blank -%}
     {{ settings.custom_code_head }}
   {%- endif -%}

   {% comment %} Open Graph Tags {% endcomment %}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:locale" content="{{ request.locale.iso_code }}">
  {% if template.name == 'product' and product %}
  <meta property="og:title" content="{{ product.title | escape }} | {{ shop.name }}">
  {% elsif template.name == 'collection' and collection %}
  <meta property="og:title" content="{{ collection.title | escape }} - Buy Online at {{ shop.name }}">
  {% else %}
  <meta property="og:title" content="{{ page_title | escape }}">
  {% endif %}
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape | truncate: 155 }}">{% endif %}
  {% if page_image %}
  <meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="628">
  <meta property="og:image:alt" content="{{ page_title | escape }}">
  <meta name="twitter:image" content="{{ page_image | image_url: width: 1200 }}">
  <meta name="twitter:image:alt" content="{{ page_title | escape }}">
  {% elsif settings.social_sharing_image %}
  <meta property="og:image" content="{{ settings.social_sharing_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="{{ settings.social_sharing_image | image_url: width: 1200 }}">
  {% endif %}
  <meta property="og:type" content="{% if template.name == 'product' %}product{% elsif template.name == 'article' %}article{% else %}website{% endif %}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if template.name == 'product' and product %}{{ product.title | escape }}{% else %}{{ page_title | escape }}{% endif %}">
  {% if page_description %}<meta name="twitter:description" content="{{ page_description | escape | truncate: 155 }}">{% endif %}

  {% if template.name == 'product' and product %}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency }}">
  <meta property="product:price:currency" content="{{ shop.currency.iso_code }}">
  {% endif %}


  {%- if settings.type_header_font.system? == false -%}
    <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" crossorigin>
  {%- endif -%}
  {%- if settings.type_body_font.system? == false -%}
    <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" crossorigin>
  {%- endif -%}

  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">

  {%- liquid
    assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
    assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
    assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
  -%}

  <style>
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}

    :root {
      --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --font-body-style: {{ settings.type_body_font.style }};
      --font-body-weight: {{ settings.type_body_font.weight }};
      --font-body-weight-bold: {{ settings.type_body_font.weight | plus: 300 | at_most: 1000 }};
      --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      --font-heading-style: {{ settings.type_header_font.style }};
      --font-heading-weight: {{ settings.type_header_font.weight }};
      --font-body-size: {{ settings.type_body_size }}px;

      --color-header-bg: {{ settings.header_bg_color }};
      --color-accent-primary: {{ settings.color_accent_primary }};
      --color-accent-secondary: {{ settings.color_accent_secondary }};
      --color-link: {{ settings.color_link }};
      --color-body-bg: {{ settings.color_body_bg }};
      --color-text-primary: {{ settings.color_text_primary }};

      --color-nav-dark: {{ settings.header_bg_color }};
      --color-nav-dark-hover: {{ settings.header_bg_color | color_darken: 5 }};
      --color-accent-red: {{ settings.color_accent_primary }};
      --color-accent-red-dark: {{ settings.color_accent_primary | color_darken: 10 }};
      --color-accent-red-light: {{ settings.color_accent_secondary }};
    }

    body {
      font-family: var(--font-body-family);
      font-style: var(--font-body-style);
      font-weight: var(--font-body-weight);
      font-size: var(--font-body-size);
      background-color: var(--color-body-bg);
    }

    h1, h2, h3, h4, h5, h6, .section-title {
      font-family: var(--font-heading-family);
      font-style: var(--font-heading-style);
      font-weight: var(--font-heading-weight);
    }
  </style>

  {{ content_for_header }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>

<body id="body" class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}{% if request.design_mode %} shopify-design-mode{% endif %} site-wrapper">

  {%- if settings.custom_code_body_start != blank -%}
    {{ settings.custom_code_body_start }}
  {%- endif -%}

  <!-- Skip to content (Accessibility requirement #12) -->
  <a class="skip-to-content-link button" href="#MainContent">
    {{ 'accessibility.skip_to_text' | t }}
  </a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <!-- Cart Drawer -->
  {% section 'cart-drawer' %}

  <!-- Cookie Banner -->
  {% section 'cookie-banner' %}

  <!-- Newsletter Popup -->
  {% section 'newsletter-popup' %}

  <!-- Age Gate -->
  {% section 'age-gate' %}

  <!-- Social Proof -->
  {% section 'social-proof' %}

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu-overlay" class="mobile-overlay hidden" aria-hidden="true"></div>
  <nav id="mobile-menu" class="mobile-menu-drawer hidden" aria-hidden="true" aria-label="{{ 'general.navigation.menu' | t }}">
    <div class="mobile-menu-header">
      <span class="mobile-menu-title">{{ 'general.navigation.menu' | t }}</span>
      <button class="mobile-menu-close" aria-label="{{ 'accessibility.close' | t }}">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>
    <div class="mobile-menu-nav">
      {% for link in linklists[settings.main_menu].links %}
        {% if link.links != blank %}
          <details class="mobile-menu-item-with-children">
            <summary class="mobile-menu-item">
              {{ link.title }}
              <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
            </summary>
            <div class="mobile-submenu">
              {% for child_link in link.links %}
                <a href="{{ child_link.url }}" class="mobile-submenu-item"{% if child_link.active %} aria-current="page"{% endif %}>{{ child_link.title }}</a>
              {% endfor %}
            </div>
          </details>
        {% else %}
          <a href="{{ link.url }}" class="mobile-menu-item"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    </div>
    <div class="mobile-menu-footer">
      {% if shop.customer_accounts_enabled %}
        {% if customer %}
          <a href="{{ routes.account_url }}" class="mobile-menu-account-link">
            <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>
            {{ customer.first_name }}
          </a>
          {{ 'customer.log_out' | t | link_to: routes.account_logout_url, class: 'mobile-menu-logout' }}
        {% else %}
          <a href="{{ routes.account_login_url }}" class="mobile-menu-account-link">
            <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>
            {{ 'customer.login.title' | t }}
          </a>
        {% endif %}
      {% endif %}
    </div>
  </nav>

  <!-- Search Modal -->
  <div id="search-modal" class="search-modal hidden" aria-hidden="true" role="dialog" aria-label="{{ 'general.search.placeholder' | t }}">
    <div class="search-modal-overlay" aria-hidden="true"></div>
    <div class="search-modal-content">
      <form action="{{ routes.search_url }}" method="get" class="search-modal-form header-search-wrap" role="search">
        <input type="hidden" name="type" value="product">
        <div class="search-modal-input-wrap">
          <span class="material-symbols-outlined search-icon" aria-hidden="true">search</span>
          <input
            type="search"
            name="q"
            id="search-modal-input"
            placeholder="{{ 'general.search.placeholder' | t }}"
            class="header-search-input search-modal-input"
            autocomplete="off"
            aria-label="{{ 'general.search.placeholder' | t }}"
            aria-expanded="false"
            aria-controls="search-modal-results"
            role="combobox"
          >
          <button type="button" class="search-modal-close" aria-label="{{ 'accessibility.close' | t }}">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
          </button>
        </div>
        <div id="search-modal-results" role="listbox" aria-label="Search suggestions"></div>
      </form>
    </div>
  </div>

  <!-- Predictive Search Results Panel (desktop header) -->
  <div id="predictive-results-desktop" style="display:none"></div>

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.__theme = {
      routes: {
        cart_add_url: "{{ routes.cart_add_url }}",
        cart_url: "{{ routes.cart_url }}",
        search_url: "{{ routes.search_url }}"
      },
      shop: {
        currency: {{ shop.currency | json }},
        money_format: {{ shop.money_format | json }}
      },
      settings: {
        free_shipping_threshold: {{ settings.cart_free_shipping_threshold | default: 50 | times: 100 }},
        cart_type: {{ settings.cart_type | default: 'drawer' | json }},
        predictive_search: {{ settings.search_predictive | default: true | json }}
      },
      strings: {
        add_to_cart: {{ 'products.general.add_to_cart' | t | json }},
        sold_out: {{ 'products.general.sold_out' | t | json }},
        cart_empty: {{ 'sections.cart.empty' | t | json }}
      }
    };
  </script>

   <script src="{{ 'theme.js' | asset_url }}" defer></script>

  <!-- Structured Data / JSON-LD (SEO) -->
  {%- if template.name == 'product' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": "{{ shop.url }}{{ product.url }}",
      "image": [
        {%- for image in product.images limit: 3 -%}
          "{{ image | image_url: width: 800 }}"{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "description": {{ product.description | strip_html | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | json }}
      },
      "offers": {
        "@type": "Offer",
        "url": "{{ shop.url }}{{ product.url }}",
        "priceCurrency": {{ shop.currency | json }},
        "price": "{{ product.price | money_without_currency }}",
        "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
        "seller": {
          "@type": "Organization",
          "name": {{ shop.name | json }}
        }
      }
    }
    </script>
  {%- endif -%}

  {%- if template.name == 'index' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    </script>
  {%- endif -%}

  {% if template.name == 'product' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": "{{ shop.url }}{{ product.url }}",
    {% if product.featured_image %}"image": ["{{ product.featured_image | image_url: width: 1200 }}"],{% endif %}
    "description": {{ product.description | strip_html | json }}{% if product.vendor %},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} }{% endif %},
    {% assign variant = product.selected_or_first_available_variant %}
    "sku": {{ variant.sku | json | default: product.id | json }},
    "offers": {
      "@type": "Offer",
      "sku": {{ variant.sku | json | default: product.id | json }},
      "priceCurrency": {{ shop.currency.iso_code | json }},
      "price": "{{ variant.price | money_without_currency }}",
      "priceValidUntil": "{{ 'now' | date: '%Y-12-31' }}",
      "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "url": "{{ shop.url }}{{ product.url }}",
      "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{ product.metafields.reviews.rating | default: 4.5 }}",
      "reviewCount": "{{ product.metafields.reviews.rating_count | default: 0 }}"
    }
  }
  </script>
  {% endif %}

  {% if template.name == 'collection' and collection.products_count > 0 %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "CollectionPage",
    "name": {{ collection.title | json }},
    "description": {{ collection.description | strip_html | json }},
    "url": "{{ shop.url }}{{ collection.url }}",
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ collection.all_products_count }},
      "itemListElement": [{% for product in collection.products limit: 10 %}{ "@type": "ListItem", "position": {{ forloop.index }}, "url": "{{ shop.url }}{{ product.url }}"}{% unless forloop.last %},{% endunless %}{% endfor %}]
    }
  }
  </script>
  {% endif %}

  {% if template.name == 'index' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "description": {{ shop.meta_description | json | default: shop.description | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": "{{ shop.url }}/search?q={search_term_string}" },
      "query-input": "required name=search_term_string"
    },
    "publisher": { "@type": "Organization", "name": {{ shop.name | json }} }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "sameAs": [
      {% if settings.social_facebook != blank %}"{{ settings.social_facebook }}",{% endif %}
      {% if settings.social_instagram != blank %}"{{ settings.social_instagram }}",{% endif %}
      {% if settings.social_twitter != blank %}"{{ settings.social_twitter }}",{% endif %}
      {% if settings.social_youtube != blank %}"{{ settings.social_youtube }}",{% endif %}
      {% if settings.social_tiktok != blank %}"{{ settings.social_tiktok }}",{% endif %}
      {% if settings.social_pinterest != blank %}"{{ settings.social_pinterest }}"{% endif %}
    ]
  }
  </script>
  {% endif %}

  {% if template.name == 'article' and article %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "url": "{{ shop.url }}{{ article.url }}",
    {% if article.image %}"image": "{{ article.image | image_url: width: 1200 }}",{% endif %}
    "datePublished": "{{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
    "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
    "author": { "@type": "Person", "name": {{ article.author | json }} },
    "publisher": { "@type": "Organization", "name": {{ shop.name | json }} }
  }
  </script>
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}" }
      {% if template.name == 'product' and product %}
      ,
      { "@type": "ListItem", "position": 2, "name": {{ product.vendor | json | default: 'Product' }}, "item": "{{ shop.url }}{{ product.url }}" }
      {% elsif template.name == 'collection' and collection %}
      ,
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": "{{ shop.url }}{{ collection.url }}" }
      {% elsif template.name == 'blog' and blog %}
      ,
      { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": "{{ shop.url }}{{ blog.url }}" }
      {% elsif template.name == 'article' and article %}
      ,
      { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": "{{ shop.url }}{{ blog.url }}" },
      { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": "{{ shop.url }}{{ article.url }}" }
      {% endif %}
    ]
  }
   </script>

   {%- if settings.custom_code_body_end != blank -%}
     {{ settings.custom_code_body_end }}
   {%- endif -%}

 </body>
</html>
