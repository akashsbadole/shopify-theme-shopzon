<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ gift_card.initial_value | money_without_trailing_zeros }} Gift Card — {{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <style>
    body { background: var(--color-surface); }
    .gift-card-page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 40px 20px; }
    .gift-card-logo { font-size: 26px; font-weight: 800; color: var(--color-nav-dark); margin-bottom: 32px; text-decoration: none; }
    .gift-card-logo span { color: var(--color-accent-red); }
    .gift-card { background: #fff; border: 1px solid var(--color-border); border-radius: 8px; max-width: 480px; width: 100%; overflow: hidden; }
    .gift-card__visual { background: linear-gradient(135deg, #232F3E, #37475A); padding: 32px; color: #fff; text-align: center; }
    .gift-card__amount { font-size: 48px; font-weight: 800; color: var(--color-accent-red); }
    .gift-card__shop { font-size: 14px; opacity: 0.8; margin-top: 4px; }
    .gift-card__body { padding: 32px; }
    .gift-card__code-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-secondary); margin-bottom: 8px; }
    .gift-card__code { font-size: 22px; font-weight: 700; letter-spacing: 0.1em; background: var(--color-surface); border: 2px dashed var(--color-border); border-radius: var(--border-radius); padding: 14px; text-align: center; cursor: pointer; color: var(--color-text-primary); }
    .gift-card__balance { font-size: 14px; color: var(--color-text-secondary); margin-top: 12px; text-align: center; }
    .gift-card__balance strong { color: var(--color-success); }
    .gift-card__actions { display: flex; flex-direction: column; gap: 10px; margin-top: 24px; }
    .gift-card__print { font-size: 13px; color: var(--color-link); text-align: center; cursor: pointer; background: none; border: none; }
  </style>
</head>
<body>
  <div class="gift-card-page">
    <a href="{{ routes.root_url }}" class="gift-card-logo">{{ shop.name | split: ' ' | first }}<span>{{ shop.name | split: ' ' | last }}</span></a>

    <div class="gift-card">
      <div class="gift-card__visual">
        <div style="font-size:14px;font-weight:600;margin-bottom:8px;opacity:0.8">Gift Card</div>
        <div class="gift-card__amount">{{ gift_card.initial_value | money_without_trailing_zeros }}</div>
        <div class="gift-card__shop">{{ shop.name }}</div>
      </div>

      <div class="gift-card__body">
        <p style="font-size:14px;color:var(--color-text-secondary);text-align:center;margin-bottom:24px;line-height:1.6">
          Someone special sent you a gift! Use the code below at checkout to redeem your gift card.
        </p>

        <div class="gift-card__code-label">Your Gift Card Code</div>
        <div class="gift-card__code" id="gift-card-code" onclick="copyCode(this)" title="Click to copy">
          {{ gift_card.code | format_code }}
        </div>

        {% unless gift_card.enabled %}
          <p style="color:var(--color-error);font-size:13px;text-align:center;margin-top:12px;font-weight:600">This gift card has been disabled.</p>
        {% endunless %}

        <div class="gift-card__balance">
          Remaining balance: <strong>{{ gift_card.balance | money }}</strong>
          {% if gift_card.expires_on %}
            · Expires {{ gift_card.expires_on | date: '%B %-d, %Y' }}
          {% endif %}
        </div>

        <div class="gift-card__actions">
          <a href="{{ routes.root_url }}" class="btn btn-primary btn-full" style="text-align:center">
            Shop Now
          </a>
          <button class="gift-card__print" onclick="window.print()">
            🖨️ Print this gift card
          </button>
        </div>

        <p style="font-size:12px;color:var(--color-text-muted);text-align:center;margin-top:20px">
          Keep this page safe — share it with the recipient if this is a gift.
        </p>
      </div>
    </div>
  </div>

  <script>
    function copyCode(el) {
      const code = el.textContent.trim().replace(/\s/g, '');
      navigator.clipboard.writeText(code).then(() => {
        const orig = el.textContent;
        el.textContent = '✓ Copied!';
        el.style.color = 'var(--color-success)';
        setTimeout(() => { el.textContent = orig; el.style.color = ''; }, 2000);
      });
    }
  </script>
  {{ content_for_layout }}
</body>
</html>
