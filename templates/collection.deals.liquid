{% comment %} Deals Collection Template {% endcomment %}

<div class="page-container" style="padding-top:var(--space-4);padding-bottom:var(--space-8)">

  <nav class="breadcrumb" aria-label="{{ 'general.breadcrumbs.aria_label' | t | default: 'Breadcrumb' }}">
    <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t | default: 'Home' }}</a>
    <span class="breadcrumb-sep" aria-hidden="true">›</span>
    <span aria-current="page">{{ collection.title }}</span>
  </nav>

  <div style="background:linear-gradient(135deg,#232F3E,#C0392B);border-radius:var(--border-radius);padding:var(--space-6);margin-bottom:var(--space-5);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--space-4)">
    <div>
      <h1 style="font-size:var(--font-size-2xl);font-weight:800;color:#fff;margin-bottom:var(--space-2)">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <p style="color:rgba(255,255,255,0.8);max-width:600px">{{ collection.description }}</p>
      {% else %}
        <p style="color:rgba(255,255,255,0.8)">Huge savings on selected products. Limited time only!</p>
      {% endif %}
    </div>
    {% assign deal_count = 0 %}
    {% for product in collection.products %}
      {% if product.compare_at_price > product.price %}
        {% assign deal_count = deal_count | plus: 1 %}
      {% endif %}
    {% endfor %}
    <div style="background:rgba(255,255,255,0.15);border-radius:var(--border-radius);padding:var(--space-4) var(--space-5);text-align:center">
      <div style="font-size:32px;font-weight:800;color:#C0392B;line-height:1">{{ deal_count }}</div>
      <div style="font-size:12px;color:rgba(255,255,255,0.7);text-transform:uppercase;letter-spacing:0.08em">Hot Deals</div>
    </div>
  </div>

  <div style="background:var(--color-accent-red);border-radius:var(--border-radius);padding:var(--space-3) var(--space-4);margin-bottom:var(--space-5);display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap">
    <span class="material-symbols-outlined" style="font-size:18px;color:#131921">local_fire_department</span>
    <span style="font-size:13px;font-weight:600;color:#131921">Hurry! Deals end soon. Extra 5% off applied at checkout with code: <strong>SAVE5</strong></span>
  </div>

  <div class="collection-layout">
    <aside class="collection-sidebar" id="collection-sidebar" aria-label="{{ 'collections.filtering.title' | t | default: 'Filters' }}">
      <div style="font-size:var(--font-size-md);font-weight:700;margin-bottom:var(--space-4);display:flex;align-items:center;justify-content:space-between">
        <span>{{ 'collections.filtering.title' | t | default: 'Filters' }}</span>
        {% if collection.active_filters.size > 0 %}
          <a href="{{ collection.url }}" style="font-size:12px;color:var(--color-link);font-weight:400">Clear all</a>
        {% endif %}
      </div>
      {% render 'faceted-filters', results: collection, section: section %}
    </aside>

    <div class="collection-main">
      <div class="collection-toolbar">
        <div style="display:flex;align-items:center;gap:var(--space-3)">
          <button id="filter-toggle" class="btn btn-ghost btn-sm" style="display:none" aria-expanded="false" aria-controls="collection-sidebar">
            <span class="material-symbols-outlined" style="font-size:16px">tune</span>
            {{ 'collections.filtering.title' | t | default: 'Filters' }}
          </button>
          <p class="collection-count" aria-live="polite">
            {% if collection.products_count == 1 %}
              1 product
            {% else %}
              {{ collection.products_count }} products
            {% endif %}
          </p>
        </div>
        <div class="collection-sort">
          <label for="sort-select" class="sr-only">Sort by</label>
          <select id="sort-select" class="field-input" aria-label="Sort by" style="padding:4px 28px 4px 8px;font-size:13px">
            {% for option in collection.sort_options %}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                {{ option.name }}
              </option>
            {% endfor %}
          </select>
        </div>
      </div>

      <div id="ProductGrid" class="products-grid products-grid--2">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <div style="grid-column:1/-1;text-align:center;padding:var(--space-12)">
            <span class="material-symbols-outlined" style="font-size:64px;display:block;margin-bottom:var(--space-4);color:var(--color-border)">shopping_discount</span>
            <p style="font-size:var(--font-size-lg);font-weight:700;margin-bottom:8px">No deals found</p>
            <p style="color:var(--color-text-secondary);margin-bottom:var(--space-5)">Check back soon for amazing discounts!</p>
            <a href="{{ routes.root_url }}/collections/all" class="btn btn-primary">Browse All Products</a>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        {% render 'pagination', paginate: paginate %}
      {% endif %}
    </div>
  </div>

</div>

<style>
  @media (max-width:1024px) {
    #filter-toggle { display:flex !important; }
    .collection-layout { grid-template-columns:1fr !important; }
    .collection-sidebar { display:none; }
    .collection-sidebar.open { display:block; }
  }
</style>
