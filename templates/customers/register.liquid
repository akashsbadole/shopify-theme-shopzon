{% comment %} Customer Register Template {% endcomment %}

<div class="auth-page" style="align-items:flex-start;padding-top:var(--space-6)">
  <div style="width:100%;max-width:480px">

    <!-- Logo -->
    <div class="auth-logo" style="margin-bottom:var(--space-4)">
      <a href="{{ routes.root_url }}" style="font-size:26px;font-weight:800;color:var(--color-nav-dark);text-decoration:none">
        {{ shop.name | split: ' ' | first }}<span style="color:var(--color-accent-red)">{{ shop.name | split: ' ' | last }}</span>
      </a>
    </div>

    <div class="auth-card">
      <h1 class="auth-title">Create account</h1>
      <p class="auth-subtitle" style="margin-bottom:var(--space-4)">Join us for a faster checkout and exclusive deals</p>

      {% form 'create_customer' %}
        {% if form.errors %}
          <div style="background:var(--color-error-container,#ffdad6);border:1px solid var(--color-error);border-radius:var(--border-radius);padding:var(--space-3);margin-bottom:var(--space-4);font-size:13px;color:var(--color-error)">
            <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle">error</span>
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="form-row form-row--2" style="margin-bottom:var(--space-4)">
          <div class="field">
            <label class="field-label" for="reg-first-name">First name</label>
            <input class="field-input" type="text" name="customer[first_name]" id="reg-first-name" autocomplete="given-name" placeholder="First name" value="{{ form.first_name }}">
          </div>
          <div class="field">
            <label class="field-label" for="reg-last-name">Last name</label>
            <input class="field-input" type="text" name="customer[last_name]" id="reg-last-name" autocomplete="family-name" placeholder="Last name" value="{{ form.last_name }}">
          </div>
        </div>

        <div class="field" style="margin-bottom:var(--space-4)">
          <label class="field-label" for="reg-email">Email address <span>*</span></label>
          <input class="field-input" type="email" name="customer[email]" id="reg-email" autocomplete="email" placeholder="you@example.com" value="{{ form.email }}" required>
        </div>

        <div class="field" style="margin-bottom:var(--space-2)">
          <label class="field-label" for="reg-password">Password <span>*</span></label>
          <div style="position:relative">
            <input class="field-input" type="password" name="customer[password]" id="reg-password" autocomplete="new-password" placeholder="At least 8 characters" required style="padding-right:44px">
            <button type="button" onclick="togglePasswordVisibility('reg-password',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--color-text-secondary);display:flex;align-items:center">
              <span class="material-symbols-outlined" style="font-size:18px">visibility</span>
            </button>
          </div>
          <span class="field-hint">Minimum 8 characters</span>
        </div>

        <!-- Password strength indicator -->
        <div style="margin-bottom:var(--space-4)">
          <div id="pw-strength-bar" style="height:3px;background:var(--color-divider);border-radius:2px;margin-bottom:4px">
            <div id="pw-strength-fill" style="height:100%;border-radius:2px;width:0;transition:width 0.3s,background 0.3s"></div>
          </div>
          <span id="pw-strength-label" style="font-size:11px;color:var(--color-text-secondary)"></span>
        </div>

        <!-- Newsletter opt-in -->
        <label style="display:flex;align-items:flex-start;gap:10px;margin-bottom:var(--space-4);cursor:pointer;font-size:13px;color:var(--color-text-secondary)">
          <input type="checkbox" name="customer[accepts_marketing]" value="1" style="margin-top:2px;accent-color:var(--color-nav-dark)">
          <span>I'd like to receive exclusive offers, deals and news via email</span>
        </label>

        <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-bottom:var(--space-3)">Create account</button>

        <p class="auth-terms">
          By creating an account, you agree to our <a href="{{ shop.terms_of_service.url }}">Terms of Service</a> and <a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>.
        </p>
      {% endform %}

      <div class="auth-switch">
        Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a>
      </div>
    </div>
  </div>
</div>

<script>
function togglePasswordVisibility(inputId, btn) {
  const input = document.getElementById(inputId);
  const icon = btn.querySelector('.material-symbols-outlined');
  input.type = input.type === 'password' ? 'text' : 'password';
  icon.textContent = input.type === 'password' ? 'visibility' : 'visibility_off';
}

// Password strength
document.getElementById('reg-password')?.addEventListener('input', function() {
  const val = this.value;
  const bar = document.getElementById('pw-strength-fill');
  const label = document.getElementById('pw-strength-label');
  let score = 0;
  if (val.length >= 8) score++;
  if (/[A-Z]/.test(val)) score++;
  if (/[0-9]/.test(val)) score++;
  if (/[^A-Za-z0-9]/.test(val)) score++;

  const levels = [
    { pct: '0%', color: 'transparent', text: '' },
    { pct: '25%', color: '#B12704', text: 'Weak' },
    { pct: '50%', color: '#C0392B', text: 'Fair' },
    { pct: '75%', color: '#067D62', text: 'Good' },
    { pct: '100%', color: '#007185', text: 'Strong' }
  ];
  const level = levels[Math.min(score, 4)];
  bar.style.width = level.pct;
  bar.style.background = level.color;
  label.textContent = level.text ? `Password strength: ${level.text}` : '';
  label.style.color = level.color;
});
</script>
