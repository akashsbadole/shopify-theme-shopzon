{% comment %} Reset Password Template {% endcomment %}
<div class="auth-page">
  <div style="width:100%;max-width:460px">
    <div class="auth-logo" style="margin-bottom:var(--space-5);text-align:center">
      <a href="{{ routes.root_url }}" style="font-size:26px;font-weight:800;color:var(--color-nav-dark);text-decoration:none">
        {{ shop.name | split: ' ' | first }}<span style="color:var(--color-accent-red)">{{ shop.name | split: ' ' | last }}</span>
      </a>
    </div>
    <div class="auth-card">
      <h1 class="auth-title">{{ 'customer.recover_password.title' | t | default: 'Reset your password' }}</h1>
      <p class="auth-subtitle">{{ 'customer.recover_password.subtext' | t | default: "We'll send you an email to reset your password." }}</p>

      {% form 'recover_customer_password' %}
        {% if form.posted_successfully? %}
          <div style="background:#d1fae5;border:1px solid #067D62;border-radius:var(--border-radius);padding:var(--space-3);font-size:13px;color:#065f46;margin-bottom:var(--space-4)">
            <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle">check_circle</span>
            {{ 'customer.recover_password.success' | t | default: 'Check your email for a link to reset your password.' }}
          </div>
        {% endif %}
        {% if form.errors %}
          <div style="background:#fee2e2;border:1px solid var(--color-error);border-radius:var(--border-radius);padding:var(--space-3);font-size:13px;color:var(--color-error);margin-bottom:var(--space-4)">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
        <div class="field" style="margin-bottom:var(--space-4)">
          <label class="field-label" for="recover-email">{{ 'customer.login.email' | t | default: 'Email' }} <span>*</span></label>
          <input class="field-input" type="email" name="email" id="recover-email" autocomplete="email" placeholder="you@example.com" required>
        </div>
        <button type="submit" class="btn btn-primary btn-full btn-lg">{{ 'customer.recover_password.submit' | t | default: 'Send reset link' }}</button>
      {% endform %}

      <div class="auth-switch">
        <a href="{{ routes.account_login_url }}">{{ 'customer.recover_password.cancel' | t | default: 'Back to sign in' }}</a>
      </div>
    </div>
  </div>
</div>
