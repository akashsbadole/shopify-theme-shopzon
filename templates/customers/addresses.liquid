{% comment %} Customer Addresses Template {% endcomment %}

<div class="page-container" style="padding-top:var(--space-4);padding-bottom:var(--space-10)">
  <nav class="breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href="{{ routes.account_url }}">Account</a>
    <span class="breadcrumb-sep">›</span>
    <span>Addresses</span>
  </nav>

  <div style="display:grid;grid-template-columns:220px 1fr;gap:var(--space-5);align-items:start">
    <aside>
      <div style="background:var(--color-surface-white);border:1px solid var(--color-border);border-radius:var(--border-radius);overflow:hidden">
        <a href="{{ routes.account_url }}" style="display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--color-divider);color:var(--color-text-primary);text-decoration:none;font-size:14px;font-weight:500" onmouseover="this.style.background='var(--color-surface)'" onmouseout="this.style.background=''">
          <span class="material-symbols-outlined" style="font-size:18px;color:var(--color-accent-orange)">orders</span> Orders
        </a>
        <a href="{{ routes.account_addresses_url }}" style="display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--color-divider);color:var(--color-text-primary);text-decoration:none;font-size:14px;font-weight:700;background:var(--color-surface)">
          <span class="material-symbols-outlined" style="font-size:18px;color:var(--color-accent-orange)">location_on</span> Addresses
        </a>
        <a href="{{ routes.account_logout_url }}" style="display:flex;align-items:center;gap:10px;padding:12px 16px;color:var(--color-error);text-decoration:none;font-size:14px;font-weight:500" onmouseover="this.style.background='var(--color-surface)'" onmouseout="this.style.background=''">
          <span class="material-symbols-outlined" style="font-size:18px">logout</span> Sign Out
        </a>
      </div>
    </aside>

    <div>
      <!-- Add New -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-4)">
        <h1 style="font-size:21px;font-weight:700">My Addresses</h1>
        <button class="btn btn-primary btn-sm" onclick="toggleAddressForm('new')" id="toggle-new-form">
          <span class="material-symbols-outlined" style="font-size:16px">add</span>
          Add Address
        </button>
      </div>

      <!-- New Address Form -->
      <div id="address-form-new" style="display:none;background:var(--color-surface-white);border:1px solid var(--color-border);border-radius:var(--border-radius);padding:var(--space-5);margin-bottom:var(--space-4)">
        <h2 style="font-size:16px;font-weight:700;margin-bottom:var(--space-4)">Add New Address</h2>
        {% form 'customer_address', customer.new_address %}
          {% render 'address-form', form: form %}
          <div style="display:flex;gap:var(--space-2);margin-top:var(--space-4)">
            <button type="submit" class="btn btn-primary">Save Address</button>
            <button type="button" class="btn btn-ghost" onclick="toggleAddressForm('new')">Cancel</button>
          </div>
        {% endform %}
      </div>

      <!-- Existing Addresses -->
      {% if customer.addresses.size > 0 %}
        <div style="display:grid;gap:var(--space-3)">
          {% for address in customer.addresses %}
            <div style="background:var(--color-surface-white);border:{% if address == customer.default_address %}2px solid var(--color-accent-orange){% else %}1px solid var(--color-border){% endif %};border-radius:var(--border-radius);padding:var(--space-4)">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-3)">
                <div>
                  {% if address == customer.default_address %}
                    <span style="background:var(--color-accent-orange);color:#131921;font-size:11px;font-weight:700;padding:2px 8px;border-radius:99px;display:inline-block;margin-bottom:8px">Default</span>
                  {% endif %}
                  <address style="font-style:normal;font-size:14px;line-height:1.8;color:var(--color-text-primary)">
                    <strong>{{ address.name }}</strong><br>
                    {% if address.company != blank %}{{ address.company }}<br>{% endif %}
                    {{ address.address1 }}<br>
                    {% if address.address2 != blank %}{{ address.address2 }}<br>{% endif %}
                    {{ address.city }}, {{ address.province_code }} {{ address.zip }}<br>
                    {{ address.country }}<br>
                    {% if address.phone != blank %}{{ address.phone }}{% endif %}
                  </address>
                </div>
                <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0">
                  <button class="btn btn-ghost btn-sm" onclick="toggleAddressForm('{{ address.id }}')">Edit</button>
                  {% unless address == customer.default_address %}
                    {% form 'customer_address', address %}
                      <input type="hidden" name="_method" value="delete">
                      <button type="submit" class="btn btn-sm" style="background:none;border:1px solid var(--color-error);color:var(--color-error);border-radius:var(--border-radius-btn);padding:6px 14px;font-size:13px;font-weight:600;cursor:pointer" onclick="return confirm('Delete this address?')">Delete</button>
                    {% endform %}
                    {% form 'customer_address', address %}
                      <input type="hidden" name="_method" value="put">
                      <input type="hidden" name="address[default]" value="true">
                      <button type="submit" class="btn btn-ghost btn-sm">Set Default</button>
                    {% endform %}
                  {% endunless %}
                </div>
              </div>

              <!-- Edit form -->
              <div id="address-form-{{ address.id }}" style="display:none;margin-top:var(--space-4);padding-top:var(--space-4);border-top:1px solid var(--color-divider)">
                {% form 'customer_address', address %}
                  <input type="hidden" name="_method" value="put">
                  {% render 'address-form', form: form %}
                  <div style="display:flex;gap:var(--space-2);margin-top:var(--space-4)">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <button type="button" class="btn btn-ghost" onclick="toggleAddressForm('{{ address.id }}')">Cancel</button>
                  </div>
                {% endform %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div style="background:var(--color-surface-white);border:1px solid var(--color-border);border-radius:var(--border-radius);padding:var(--space-10);text-align:center;color:var(--color-text-secondary)">
          <span class="material-symbols-outlined" style="font-size:48px;display:block;margin-bottom:12px;color:var(--color-border)">location_on</span>
          <p style="font-weight:600;margin-bottom:8px">No saved addresses</p>
          <p style="font-size:13px">Add a shipping address to speed up checkout.</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
function toggleAddressForm(id) {
  const form = document.getElementById('address-form-' + id);
  if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
}
</script>
