<section class="page-section" data-reveal>
  <div class="page-container">
    <div class="image-with-text {% if section.settings.layout == 'image_right' %}image-with-text--reverse{% endif %}">

      <!-- Image -->
      <div class="image-with-text__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 900 | image_tag:
            loading: 'lazy',
            alt: section.settings.heading,
            style: 'width:100%;height:100%;object-fit:cover'
          }}
        {% else %}
          <div style="width:100%;height:100%;min-height:400px;background:linear-gradient(135deg,#232F3E,#37475A);display:flex;align-items:center;justify-content:center">
            <span class="material-symbols-outlined" style="font-size:64px;color:rgba(255,255,255,0.2)">image</span>
          </div>
        {% endif %}
      </div>

      <!-- Content -->
      <div class="image-with-text__content" style="background:{{ section.settings.bg_color }}">
        {% if section.settings.eyebrow != blank %}
          <div class="image-with-text__eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="image-with-text__title" style="color:{{ section.settings.text_color }}">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="image-with-text__text" style="color:{{ section.settings.text_color | color_modify: 'alpha', 0.75 }}">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.settings.btn_text != blank %}
          <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;margin-top:var(--space-2)">
            <a href="{{ section.settings.btn_url | default: '#' }}" class="btn btn-primary">{{ section.settings.btn_text }}</a>
            {% if section.settings.btn2_text != blank %}
              <a href="{{ section.settings.btn2_url | default: '#' }}" class="btn btn-ghost">{{ section.settings.btn2_text }}</a>
            {% endif %}
          </div>
        {% endif %}

        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div {{ block.shopify_attributes }} style="display:flex;align-items:center;gap:var(--space-3);padding:var(--space-3) 0;border-top:1px solid rgba(0,0,0,0.08)">
              {% if block.settings.icon != blank %}
                <span class="material-symbols-outlined" style="font-size:28px;color:var(--color-accent-red);flex-shrink:0">{{ block.settings.icon }}</span>
              {% endif %}
              <div>
                <div style="font-size:22px;font-weight:800;color:{{ section.settings.text_color }}">{{ block.settings.number }}</div>
                <div style="font-size:13px;color:{{ section.settings.text_color | color_modify: 'alpha', 0.6 }}">{{ block.settings.label }}</div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "layout", "label": "Image position", "options": [{ "value": "image_left", "label": "Image left" }, { "value": "image_right", "label": "Image right" }], "default": "image_left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Story" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn_text", "label": "Button 1 text" },
    { "type": "url", "id": "btn_url", "label": "Button 1 URL" },
    { "type": "text", "id": "btn2_text", "label": "Button 2 text" },
    { "type": "url", "id": "btn2_url", "label": "Button 2 URL" },
    { "type": "color", "id": "bg_color", "label": "Content background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0F1111" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat / Icon Row",
      "settings": [
        { "type": "text", "id": "icon", "label": "Material icon", "default": "verified" },
        { "type": "text", "id": "number", "label": "Number / Value", "default": "10K+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Happy customers" }
      ]
    }
  ],
  "presets": [{ "name": "Image with Text" }]
}
{% endschema %}
