<section class="page-section" style="background:{{ section.settings.bg_color }}" data-reveal>
  <div class="page-container">
    <div style="max-width:780px;margin:0 auto">
      {% if section.settings.title != blank %}
        <div style="text-align:{{ section.settings.text_align }};margin-bottom:var(--space-6)">
          {% if section.settings.eyebrow != blank %}
            <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent-orange);margin-bottom:var(--space-2)">{{ section.settings.eyebrow }}</div>
          {% endif %}
          <h2 style="font-size:var(--font-size-2xl);font-weight:700">{{ section.settings.title }}</h2>
          {% if section.settings.subtitle != blank %}
            <p style="color:var(--color-text-secondary);margin-top:8px">{{ section.settings.subtitle }}</p>
          {% endif %}
        </div>
      {% endif %}

      <div style="display:flex;flex-direction:column;gap:var(--space-2)">
        {% for block in section.blocks %}
          {% if block.type == 'faq_item' %}
            <details class="faq-item" {{ block.shopify_attributes }} {% if block.settings.open_by_default %}open{% endif %}
              style="background:var(--color-surface-white);border:1px solid var(--color-border);border-radius:var(--border-radius);overflow:hidden">
              <summary style="padding:var(--space-4);display:flex;align-items:center;justify-content:space-between;cursor:pointer;list-style:none;font-size:var(--font-size-body);font-weight:600;color:var(--color-text-primary);gap:var(--space-3)">
                <span>{{ block.settings.question }}</span>
                <span class="material-symbols-outlined faq-icon" style="font-size:22px;flex-shrink:0;color:var(--color-accent-orange);transition:transform 0.25s ease">expand_more</span>
              </summary>
              <div style="padding:0 var(--space-4) var(--space-4);font-size:var(--font-size-body);color:var(--color-text-secondary);line-height:1.7;border-top:1px solid var(--color-divider);padding-top:var(--space-3)">
                {{ block.settings.answer }}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.cta_text != blank %}
        <div style="text-align:center;margin-top:var(--space-6)">
          <p style="color:var(--color-text-secondary);margin-bottom:var(--space-3)">{{ section.settings.cta_text }}</p>
          <a href="{{ section.settings.cta_url | default: '/pages/contact' }}" class="btn btn-primary">{{ section.settings.cta_btn }}</a>
        </div>
      {% endif %}
    </div>
   </div>
 </section>

 {% if section.blocks.size > 0 %}
 <script type="application/ld+json">
 {
   "@context": "https://schema.org",
   "@type": "FAQPage",
   "mainEntity": [
     {% for block in section.blocks %}
     {
       "@type": "Question",
       "name": {{ block.settings.question | json }},
       "acceptedAnswer": {
         "@type": "Answer",
         "text": {{ block.settings.answer | strip_html | json }}
       }
     }{% unless forloop.last %},{% endunless %}
     {% endfor %}
   ]
 }
 </script>
 {% endif %}

 <style>
details.faq-item[open] .faq-icon { transform: rotate(180deg); }
details.faq-item summary::-webkit-details-marker { display: none; }
</style>

{% schema %}
{
  "name": "FAQ / Accordion",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "title", "label": "Section title", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "select", "id": "text_align", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#F3F3F3" },
    { "type": "text", "id": "cta_text", "label": "CTA text (optional)", "default": "Still have questions? We're happy to help." },
    { "type": "text", "id": "cta_btn", "label": "CTA button", "default": "Contact Us" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is your return policy?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>We offer a 30-day hassle-free return policy. If you're not happy with your purchase for any reason, simply contact us and we'll arrange a full refund or exchange.</p>" },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ / Accordion",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "What is your return policy?", "open_by_default": true } },
        { "type": "faq_item", "settings": { "question": "How long does shipping take?" } },
        { "type": "faq_item", "settings": { "question": "Do you offer international shipping?" } },
        { "type": "faq_item", "settings": { "question": "How do I track my order?" } }
      ]
    }
  ]
}
{% endschema %}
