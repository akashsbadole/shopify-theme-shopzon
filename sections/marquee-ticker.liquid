<section class="marquee-section" style="background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }}">
  <div class="marquee-track" style="animation-duration:{{ section.settings.speed }}s">
    {% render 'marquee-items' %}
  </div>
</section>

{% schema %}
{
  "name": "Marquee / Ticker",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#C0392B" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#131921" },
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 5, "unit": "s", "label": "Animation speed", "default": 25 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Material icon name", "placeholder": "local_shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $50" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee / Ticker",
      "blocks": [
        { "type": "item", "settings": { "icon": "local_shipping", "text": "Free shipping on orders over $50" } },
        { "type": "item", "settings": { "icon": "autorenew", "text": "30-day hassle-free returns" } },
        { "type": "item", "settings": { "icon": "verified", "text": "Authentic products guaranteed" } },
        { "type": "item", "settings": { "icon": "support_agent", "text": "24/7 customer support" } }
      ]
    }
  ]
}
{% endschema %}
